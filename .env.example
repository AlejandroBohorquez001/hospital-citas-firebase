# ====================================================================
# CONFIGURACIÓN DEL PROVEEDOR DE BASE DE DATOS
# Valores soportados: "postgres" | "firestore"
# ====================================================================
DB_PROVIDER=postgres

# ====================================================================
# VERSIÓN A: POSTGRESQL (Neon / Supabase / Render / Local)
# Usado cuando DB_PROVIDER=postgres
# ====================================================================
# Cadena de conexión estándar (Prisma)
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Si usas Supabase con Connection Pooling (PgBouncer), descomenta DIRECT_URL:
# DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# ====================================================================
# VERSIÓN B: FIREBASE FIRESTORE (SDK firebase-admin server-side)
# Usado cuando DB_PROVIDER=firestore
# ====================================================================
# Opción 1: Credenciales individuales de la cuenta de servicio de Firebase
FIREBASE_PROJECT_ID="hospital-citas-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@hospital-citas-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Opción 2 (Alternativa recomendada para Vercel): JSON completo en una sola línea
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"hospital-citas-app",...}'
